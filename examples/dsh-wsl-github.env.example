# Copy to ~/.dsh/dsh-wsl-github.env and fill in. Never commit the real file or PEM.
# Then: source "$HOME/.dsh/dsh-wsl-github.env" before `dsh web`.

export GITHUB_APP_ID=
export GITHUB_APP_PRIVATE_KEY_PATH="$HOME/.dsh/dsh-wsl-github.pem"
# Optional — pin one installation; otherwise the plugin picks by repo owner:
# export GITHUB_APP_INSTALLATION_ID=

# Create App: https://github.com/settings/apps/new
# Homepage: https://github.com/173787247/dsh-wsl-kit
# Permissions: Metadata (RO), Pull requests (RO), Actions (RO); disable webhook.
# Download PEM → ~/.dsh/dsh-wsl-github.pem (chmod 600)
# Install the App on your user/org, then smoke: github_app_hint / github_repo_status
